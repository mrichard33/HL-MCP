      "id": "3a6e9e1f-3055-4c6b-892d-5b0d83688b3e",
      "name": "Get Contacts from Supabase",
      "credentials": {
        "httpBearerAuth": {
          "id": "uqGF0KatajiU9219",
          "name": "Supabase Highlevel MCP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Supabase REST API returns an array directly\nconst items = $input.all();\nconst allContacts = [];\n\nfor (const item of items) {\n  const data = Array.isArray(item.json) ? item.json : (item.json.body || [item.json]);\n  for (const contact of data) {\n    if (contact.ghl_contact_id) {\n      allContacts.push({ json: { ghl_contact_id: contact.ghl_contact_id } });\n    }\n  }\n}\n\nif (allContacts.length === 0) {\n  return [{ json: { _no_contacts: true, synced_conversations: 0, synced_messages: 0 } }];\n}\n\n// Limit to 100 contacts per run to avoid GHL rate limits\n// The scheduler runs every 15 min, so all contacts get covered over time\nconst limited = allContacts.slice(0, 100);\nconsole.log(`Processing ${limited.length} of ${allContacts.length} total contacts`);\nreturn limited;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 288],
      "id": "bc752d86-6b0a-4ed1-a138-70b164fc304e",
      "name": "Split Contacts"
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 288],
      "id": "a1b2c3d4-batch-node-0000-000000000001",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "url": "=https://services.leadconnectorhq.com/conversations/search?contactId={{ $json.ghl_contact_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "highLevelOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            },
