    {
      "parameters": {
        "jsCode": "// Collect all messages from all conversation responses\nconst allMessages = [];\n\nfor (const item of $input.all()) {\n  const messages = item.json.messages || [];\n  for (const m of messages) {\n    let direction = 'outbound';\n    if (m.direction === 'inbound' || m.direction === 1) {\n      direction = 'inbound';\n    } else if (m.direction === 'outbound' || m.direction === 2) {\n      direction = 'outbound';\n    }\n\n    let type = 'sms';\n    if (m.type) {\n      type = String(m.type).toLowerCase();\n    } else if (m.messageType === 2) {\n      type = 'email';\n    }\n\n    allMessages.push({\n      json: {\n        ghl_message_id: m.id,\n        ghl_conversation_id: m.conversationId,\n        ghl_contact_id: m.contactId || null,\n        direction: direction,\n        type: type,\n        body: m.body || null,\n        status: m.status || 'delivered',\n        sent_at: m.dateAdded || new Date().toISOString(),\n      }\n    });\n  }\n}\n\nif (allMessages.length === 0) {\n  return [{ json: { _no_messages: true } }];\n}\n\nconsole.log(`Found ${allMessages.length} messages in this batch`);\nreturn allMessages;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
