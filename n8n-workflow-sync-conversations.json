      "parameters": {
        "jsCode": "// Count total synced items across all batches\n// Query Supabase for current counts since we processed in batches\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    synced_conversations: 'batch_complete',\n    synced_messages: 'batch_complete',\n    completed_at: now,\n    status: 'success'\n  }\n}];"
