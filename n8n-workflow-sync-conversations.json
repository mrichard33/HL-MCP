        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [880, 288],
      "id": "575d1752-4034-4bcd-acc9-eb4334077066",
      "name": "Get Conversations for Contact",
      "credentials": {
        "highLevelOAuth2Api": {
          "id": "kVeAssiD7UmbKvAM",
          "name": "HighLevel OAuth2"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Collect all conversations from all contact responses\nconst allConversations = [];\n\nfor (const item of $input.all()) {\n  const conversations = item.json.conversations || [];\n  for (const c of conversations) {\n    allConversations.push({\n      json: {\n        ghl_conversation_id: c.id,\n        ghl_contact_id: c.contactId,\n        ghl_location_id: c.locationId || null,\n        type: c.type || 'sms',\n        status: 'open',\n        last_message_at: c.lastMessageDate || null,\n        unread_count: c.unreadCount || 0,\n        synced_at: new Date().toISOString(),\n      }\n    });\n  }\n}\n\nif (allConversations.length === 0) {\n  // Return a passthrough item so the loop continues\n  return [{ json: { _no_conversations: true, _passthrough: true } }];\n}\n\nconsole.log(`Found ${allConversations.length} conversations in this batch`);\nreturn allConversations;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 288],
      "id": "bf56c505-31e1-43bc-85d7-26ae583f3bf3",
      "name": "Map Conversations"
    },
