# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel API Configuration
GHL_API_KEY=your-ghl-api-key
GHL_BASE_URL=https://services.leadconnectorhq.com

# Required: GHL Location ID for API v2 calls
GHL_LOCATION_ID=your-location-id

# Firebase Auth for Internal GHL API (enables full workflow JSON extraction)
# The internal API returns complete workflow node/step/action graphs
# Get these from your existing GHL Firebase session
GHL_FIREBASE_API_KEY=AIzaSyB_w3vXmsI7WeQtrIOkjR6xTRVN5uOieiE
GHL_FIREBASE_REFRESH_TOKEN=your-firebase-refresh-token

# GHL OAuth 2.0 for Conversations/Messages API
# The GHL conversations/messages API requires OAuth 2.0 (not API keys).
# Create an app at https://marketplace.gohighlevel.com/ to get these credentials.
# After setting these, visit /crm-oauth/authorize once to complete the consent flow.
GHL_OAUTH_CLIENT_ID=your-ghl-oauth-client-id
GHL_OAUTH_CLIENT_SECRET=your-ghl-oauth-client-secret

# Scheduled Sync: automatically mirrors all GHL data to Supabase every 15 minutes.
# Enabled by default. Set to "false" to disable.
# On first startup (empty tables), performs a full historical backfill (1 year of appointments).
# Workflows every 10 min, Contacts/Opportunities/Appointments every 15 min,
# Pipelines every 30 min, Conversations/Messages every 15 min, Funnel hourly
# ENABLE_SCHEDULED_SYNC=false

# Optional: Webhook secret for verifying GoHighLevel webhook signatures
# GHL_WEBHOOK_SECRET=your-webhook-secret

# OAuth: Optional passphrase for the /authorize consent page.
# If set, users must enter this passphrase when connecting via Claude custom connections.
# If not set, authorization auto-approves (the Railway URL itself acts as the access control).
# OAUTH_AUTHORIZE_SECRET=your-passphrase-here

# HTTP Transport: set PORT to enable Streamable HTTP transport (auto-set by Railway)
# When PORT is not set, the server uses stdio transport for local CLI usage
# PORT=3000

# ── WP Journey Pages (report.getreecewindows.com) ──────────────────────────
# HMAC secret for page identity tokens (?t=<contactId>.<sig>). 32+ random bytes:
#   openssl rand -base64 32
WP_TOKEN_SECRET=your-wp-token-secret

# CORS origin allowed to POST /api/telemetry. Use the Railway-generated URL
# during verification, then the custom domain once DNS is flipped.
PAGE_ALLOWED_ORIGIN=https://report.getreecewindows.com

# Optional: GHL workflow to enroll contacts in on gate_complete. Unset = no enrollment.
# WP_FOLLOWUP_WORKFLOW_ID=your-workflow-id

# DEV ONLY: accept a bare GHL contact ID as the telemetry token without HMAC
# verification. Insecure by design — must be false (or unset) in prod.
# TRUST_RAW_CID=false

# Appointment delta gate (entity-syncer.ts syncAppointments)
# off | shadow | enforce (default shadow). shadow stores hashes + logs
# would-skip counts but still writes everything.
APPT_SYNC_DELTA_MODE=shadow
