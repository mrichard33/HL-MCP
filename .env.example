# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel API Configuration
GHL_API_KEY=your-ghl-api-key
GHL_BASE_URL=https://services.leadconnectorhq.com

# Optional: GHL Location ID (if using sub-account level access)
GHL_LOCATION_ID=your-location-id

# Scheduled Sync: automatically sync all entity data on cron schedules
# Workflows every 10 min, Contacts/Opportunities/Appointments every 15 min, Funnel hourly
ENABLE_SCHEDULED_SYNC=true

# Optional: Webhook secret for verifying GoHighLevel webhook signatures
# GHL_WEBHOOK_SECRET=your-webhook-secret

# HTTP Transport: set PORT to enable Streamable HTTP transport (auto-set by Railway)
# When PORT is not set, the server uses stdio transport for local CLI usage
# PORT=3000
