# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GoHighLevel API Configuration
GHL_API_KEY=your-ghl-api-key
GHL_BASE_URL=https://services.leadconnectorhq.com

# Required: GHL Location ID for API v2 calls
GHL_LOCATION_ID=your-location-id

# Firebase Auth for Internal GHL API (enables full workflow JSON extraction)
# The internal API returns complete workflow node/step/action graphs
# Get these from your existing GHL Firebase session
GHL_FIREBASE_API_KEY=AIzaSyB_w3vXmsI7WeQtrIOkjR6xTRVN5uOieiE
GHL_FIREBASE_REFRESH_TOKEN=your-firebase-refresh-token

# GHL OAuth 2.0 for Conversations/Messages API
# The GHL conversations/messages API requires OAuth 2.0 (not API keys).
# Create an app at https://marketplace.gohighlevel.com/ to get these credentials.
# After setting these, visit /crm-oauth/authorize once to complete the consent flow.
GHL_OAUTH_CLIENT_ID=your-ghl-oauth-client-id
GHL_OAUTH_CLIENT_SECRET=your-ghl-oauth-client-secret

# Scheduled Sync: automatically mirrors all GHL data to Supabase every 15 minutes.
# Enabled by default. Set to "false" to disable.
# On first startup (empty tables), performs a full historical backfill (1 year of appointments).
# Workflows every 10 min, Contacts/Opportunities/Appointments every 15 min,
# Pipelines every 30 min, Conversations/Messages every 15 min, Funnel hourly
# ENABLE_SCHEDULED_SYNC=false

# Optional: Webhook secret for verifying GoHighLevel webhook signatures
# GHL_WEBHOOK_SECRET=your-webhook-secret

# ── Sync delta gate (payload-hash change detection) ────────────────────────
# Controls whether a sync skips rows whose content hash is unchanged.
#   off     — write everything (pre-v2.2 behaviour)
#   shadow  — compute hashes and LOG what would be skipped, but still write all
#   enforce — write only changed rows
#
# Precedence: SYNC_DELTA_MODE_<ENTITY> > SYNC_DELTA_MODE > per-entity default.
# Defaults (v2.3): enforce for everything except conversations.
#   appointments, custom_fields, custom_values, tags, trigger_links, templates,
#   workflows  — enforce, small tables, no blast radius.
#   opportunities, contacts — enforce. Both ran a measured shadow period first:
#   opportunities fell from ~21,000 writes/cycle to an average of 4, and
#   contacts' nightly reconcile was still rewriting 23,630 of 23,984 rows.
#   conversations — NOT LISTED, and correctly so. That sync never uses the gate:
#   it is watermark-driven, asking GHL only for what changed since the last run,
#   so unchanged records are never fetched and there is nothing to skip.
#   Measured 2026-09-14: 325 of 17,792 conversations written in 24h (1.8%),
#   ~6 per cycle, ~3s per run. SYNC_DELTA_MODE_CONVERSATIONS does nothing.
#
# You should not need SYNC_DELTA_MODE_OPPORTUNITIES or _CONTACTS any more —
# the defaults now say enforce on their own. Setting them is only for pulling
# an entity BACK (to shadow or off) without a redeploy.
#
# Rollback: SYNC_DELTA_MODE=off restores pre-hashing behaviour on every sync
# without a redeploy.
#
# NOTE (v2.2.1): in v2.2 this was NOT safe for opportunities. That sync fetches
# its whole table every cycle, and v2.2 had removed its timestamp pre-filter in
# favour of the hash gate — which writes everything unless it is enforcing. So
# `off` made it upsert ~21,000 rows per 30-minute cycle instead of ~329. The
# pre-filter is back and now runs in every mode, so no delta setting can push
# write volume above the pre-hashing baseline. Keep it that way: any sync that
# fetches its full table needs its own filter in front of the gate, not the gate
# alone. See filterByNewerTimestamp in src/utils/delta-gate.ts.
# SYNC_DELTA_MODE=shadow
# SYNC_DELTA_MODE_OPPORTUNITIES=enforce
# SYNC_DELTA_MODE_CONTACTS=enforce
# SYNC_DELTA_MODE_WORKFLOWS=enforce
#
# Legacy alias, still honoured for appointments only:
# APPT_SYNC_DELTA_MODE=enforce

# OAuth: REQUIRED passcode for the /authorize consent page.
# New connector sign-ins (Claude or ChatGPT) must enter this passcode before any
# authorization code is issued. If it is not set, /authorize returns 503 and no
# new connection can be made — it fails closed, it never auto-approves.
# Existing connections are unaffected: refresh never touches /authorize.
# OAUTH_AUTHORIZE_SECRET=your-passphrase-here

# HTTP Transport: set PORT to enable Streamable HTTP transport (auto-set by Railway)
# When PORT is not set, the server uses stdio transport for local CLI usage
# PORT=3000

# ── WP Journey Pages (report.getreecewindows.com) ──────────────────────────
# HMAC secret for page identity tokens (?t=<contactId>.<sig>). 32+ random bytes:
#   openssl rand -base64 32
WP_TOKEN_SECRET=your-wp-token-secret

# CORS origin allowed to POST /api/telemetry. Use the Railway-generated URL
# during verification, then the custom domain once DNS is flipped.
PAGE_ALLOWED_ORIGIN=https://report.getreecewindows.com

# Optional: GHL workflow to enroll contacts in on gate_complete. Unset = no enrollment.
# WP_FOLLOWUP_WORKFLOW_ID=your-workflow-id

# DEV ONLY: accept a bare GHL contact ID as the telemetry token without HMAC
# verification. Insecure by design — must be false (or unset) in prod.
# TRUST_RAW_CID=false

# Appointment delta gate (entity-syncer.ts syncAppointments)
# off | shadow | enforce (default shadow). shadow stores hashes + logs
# would-skip counts but still writes everything.
#
# PRODUCTION RUNS enforce, verified 2026-09-16 in the Railway variables and in
# the live logs:
#   [DeltaGate] syncAppointments: enforce — 0 changed, 1727 unchanged skipped
# This template said `shadow`, which reads as "the gate is off" and invites
# someone to switch on something already on. SYNC_DELTA_MODE_OPPORTUNITIES and
# SYNC_DELTA_MODE_WORKFLOWS are also set to enforce on the service and were
# likewise absent here.
APPT_SYNC_DELTA_MODE=enforce

# ─── Graceful shutdown (src/graceful-shutdown.ts) ───────────────────────────
# Max time the process waits on SIGTERM for in-flight requests and tracked
# background work (emitSystemEvent, the workflow_executions tag diff, the LP
# MCP tag forward) to finish before exiting. Railway's own drainingSeconds is
# 120s, so this MUST stay below that — at or above it, Railway SIGKILLs
# mid-drain and the loss this module prevents comes straight back. Long-lived
# MCP streams (GET /mcp, GET /sse) are not counted, so they never pin the
# drain to the full window.
SHUTDOWN_GRACE_MS=90000

# ── contacts freshness stamp (migration 016, 2026-09-18) ────────────────────
# Stamp contacts.verified_at / verified_from on every contact syncContacts
# COMPARED against live GHL — including the ones the payload-hash gate skipped,
# because a hash match is a verification. synced_at cannot answer that: it only
# moves on a write, so an unchanged contact looks unchecked forever.
#
# Rate-limited server-side to once per row per day, in its own UPDATE so a
# missing column can never affect the sync itself.
# Leave false until supabase/migrations/016_contacts_verified_at.sql is applied.
GHL_VERIFIED_AT_ENABLED=false
